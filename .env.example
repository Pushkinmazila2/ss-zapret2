SS_PORT=8388
SOCKS_PORT=1080
SS_PASSWORD=SuperSecurePassword
SS_ENCRYPT_METHOD=chacha20-ietf-poly1305
SS_TIMEOUT=300
SS_VERBOSE=0
# Путь к журналу срезов ТСПУ (по умолчанию /opt/zapret2/logs/cuts.log,
# если смонтирован ./logs; иначе /run/zapret-pool/cuts.log)
# CUT_LOG_PATH=
# Дополнительные аргументы каждому nfqws2 (например, отладка):
# NFQWS2_EXTRA_ARGS=--debug=2

# TSPU_INTEL reconnaissance: ML dataset on session-cut (defaults match the code)
TSPU_INTEL_ENABLE=true
TSPU_INTEL_COOLDOWN=30
TSPU_INTEL_BUDGET_MS=1800
TSPU_INTEL_TTL_MAX=30
TSPU_INTEL_SNI=youtube.com
TSPU_INTEL_DRY_RUN=false
TSPU_INTEL_DNS=1.1.1.1